# ── Server config ────────────────────────────────────────────────
PORT=3000

# ── Admin key (optional) ──────────────────────────────────────────
# If set, every request needs header: x-admin-key: yourkey
# Leave blank to disable auth (fine for local use)
ADMIN_KEY=

# ── Webshare API key (optional) ───────────────────────────────────
# Paste your Webshare API key here if you want proxy pool auto-loaded on start
WEBSHARE_API_KEY=
